server {
    listen ${PORT};
    server_name _;
    server_tokens off;
    root /app/frontend/dist;
    index index.html;

    client_max_body_size 22m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;

    # Compress API JSON and frontend assets to reduce Render outbound bandwidth
    # and improve loading time on mobile connections.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types application/json application/javascript application/xml image/svg+xml text/css text/javascript text/plain;

    location = /up {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /api/ {
        try_files "" @laravel;
    }

    location ^~ /sanctum/ {
        try_files "" @laravel;
    }

    location @laravel {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /app/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_read_timeout 600s;
        fastcgi_send_timeout 600s;
    }

    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # Vite adds a content hash to production assets, so they can be cached
    # permanently without serving an outdated build after deployment.
    location ~* \.(?:css|js|mjs|svg|png|jpe?g|gif|webp|ico|woff2?)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ \.php$ {
        return 404;
    }
}
